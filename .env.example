# Copy to .env and fill in. .env is git-ignored.

# Privy (dashboard.privy.io). The app ID is public; the secret is server-only.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# The same app ID, exposed to the client build.
VITE_PRIVY_APP_ID=

# World server address baked into the client build. Empty in local dev (the client uses this
# host, port 7400). On Render: wss://<world service>.onrender.com/ws (set in render.yaml).
VITE_WORLD_URL=

# Game API (apps/api). The client calls VITE_API_URL (empty in dev: this host, port 7410).
VITE_API_URL=
DATABASE_URL=postgres://localhost/fr33world_dev
# Signs world tickets on the API and checks them on the world server: the same random value
# (32+ characters) on both. Server-only.
WORLD_TICKET_SECRET=
SIGNUP_BONUS_CENTS=500000

# World server deploy profile: empty locally (500 players, 30 Hz), `free` on Render's free plan.
WORLD_PROFILE=

# NEAR (the economy, packages/chain). Testnet unless NEAR_NETWORK=mainnet, CHAIN_ALLOW_MAINNET=yes
# and NEAR_USDC are set. The operator key is server-only: it can pay only within the limits each
# wallet contract enforces. NEAR_ROOT_KEY is for `deploy:near`, never for a running server.
NEAR_NETWORK=testnet
NEAR_ROOT_ACCOUNT=fr33world.testnet
NEAR_ROOT_KEY=
NEAR_OPERATOR_KEY=
# The AI advisor (cloud.near.ai). Unset: businesses keep to their rules.
NEAR_AI_KEY=

# LiveKit. Local dev server (`livekit-server --dev`): ws://localhost:7880, devkey, secret.
# Production: a LiveKit Cloud project's URL and API key/secret.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
